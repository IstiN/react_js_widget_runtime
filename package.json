{
  "name": "react-js-widget-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "coverage": "npx c8 --reporter=json --reporter=text --include='src/**' node --test \"test/*.test.js\"",
    "crap": "npx crap4js src --coverage coverage/coverage-final.json --threshold 8.0 --exclude 'src/vendor/**'",
    "build": "node esbuild.config.mjs",
    "proof": "node tool/browser-proof.mjs",
    "conformance": "node tool/conformance.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "crap4js": "github:vabhzw17eg2qu4m9-bit/crap4js#v0.34.0",
    "esbuild": "0.25.5",
    "playwright": "1.65.1"
  }
}
